#    :  read (default)  builtin/custom command
#    $  shell           shell command
#    %  shell-pipe      shell command running with the ui
#    !  shell-wait      shell command waiting for key press
#    &  shell-async     shell command running asynchronously
#read (modal) (default :)
#Read a command to evaluate.

#shell (modal) (default $)
#Read a shell command to execute.

#shell-pipe (modal) (default %)
#Read a shell command to execute piping its standard I/O to the bottom statline.

#shell-wait (modal) (default !)
#Read a shell command to execute and wait for a key press in the end.

#shell-async (modal) (default &)
#Read a shell command to execute asynchronously without standard I/O.

# Basic vars
set shellopts '-eu'
set ifs "\n"
set scrolloff 10
set icons
set shell sh
set previewer ~/.config/lf/scope
set sortby time
set ratios 1:1
set reverse

# cmds/functions
cmd open ${{
    case $(gio info $f | grep "standard::content-type" | awk -F" " '{print $2}') in
      */x-puredata) xdg-open $f;;
      text/troff) man ./ $f;;
      text/*|*/json) $EDITOR $fx;;
      */javascript|*x-shellscript) $EDITOR $fx;;
      image/x-xcf|image/svg+xml) setsid $BROWSER $f >/dev/null 2>&1 & ;;
      image/*) rotdir $f | setsid sxiv -aiobN float_sc -g $(getDim $f) 2>/dev/null | lf-select & ;;
      audio/*) mpv --input-ipc-server=/tmp/mpvsoc$(date +%%s) $f ;;
      video/*) setsid mpvop $f --input-ipc-server=/tmp/mpvsoc$(date +%%s) -quiet >/dev/null 2>&1 & ;;
      application/pdf) setsid zathura $fx >/dev/null 2>&1 & ;;
      *) for f in $fx; do setsid $OPENER $f >/dev/null 2>&1 & done;;
    esac
}}

cmd mkdir $mkdir -p "$@"

cmd extract ${{
	clear; tput cup $(($(tput lines)/3)); tput bold
	set -f
	printf "%s\n\t" "$fx"
	printf "extract?[y/N]"
	read ans
	[ $ans = "y" ] && {
		case $fx in
			*.tar.bz2)   tar xjf $fx     ;;
			*.tar.gz)    tar xzf $fx     ;;
			*.bz2)       bunzip2 $fx     ;;
			*.rar)       unrar e $fx     ;;
			*.gz)        gunzip $fx      ;;
			*.tar)       tar xf $fx      ;;
			*.tbz2)      tar xjf $fx     ;;
			*.tgz)       tar xzf $fx     ;;
			*.zip)       unzip $fx       ;;
			*.Z)         uncompress $fx  ;;
			*.7z)        7z x $fx        ;;
			*.tar.xz)    tar xf $fx      ;;
		esac
	}
}}


cmd getGeo ${{
    identify $fx | awk -F" " '{ print $3}'
}}

cmd delete ${{
  set -f
  printf "%s\n\t" "$fx"
  printf "!!!!!!!!! DELETE FILE PERMANTENTLY? !!!!!!!! [y/N]"
  read ans
  [ $ans = "y" ] && rm -r $fx
}}

cmd shrink ${{
  set -f
  printf "diminuir por quainto? "
  read ans
  [ $ans ] &&
  ffmpeg -i $f -vf "scale=iw/$ans:ih/$ans" ${f%.*}_${ans}.${f##*.}
}}

cmd zip %{{
    set -f
    printf "nome do arquivo: "
    read ans
    [ $ans ] && zip -jr $ans $fs
  }}

cmd trash ${{
  set -f
  printf "%s\n\t" "$fx"
  printf "move to trash?[y/N]"
  read ans
  [ $ans = "y" ] && mv $fx ~/.local/share/Trash/files
}}

cmd moveto ${{
	set -f
	clear; tput cup $(($(tput lines)/3))
	dest=$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' "${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs" | fzf --layout=reverse --height 40% --prompt 'Move to where? ' | sed 's|~|$HOME|')
	[ -z "$dest" ] && exit
	destpath=$(eval printf '%s' \"$dest\")
	clear; tput cup $(($(tput lines)/3)); tput bold
	echo "From:"
	echo "$fx" | sed 's/^/   /'
	printf "To:\n   %s\n\n\tmove?[y/N]" "$destpath"
	read -r ans
	[ "$ans" != "y" ] && exit
	for x in $fx; do
		mv -iv "$x" "$destpath"
	done &&
	notify-send "🚚 File(s) moved." "File(s) moved to $destpath."
}}

cmd copyto ${{
	set -f
	clear; tput cup $(($(tput lines)/3))
	dest=$(sed -e 's/\s*#.*//' -e '/^$/d' -e 's/^\S*\s*//' "${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs" | fzf --layout=reverse --height 40% --prompt 'Copy to where? ' | sed 's|~|$HOME|')
	[ -z "$dest" ] && exit
	destpath=$(eval printf '%s' \"$dest\")
	clear; tput cup $(($(tput lines)/3)); tput bold
	echo "From:"
	echo "$fx" | sed 's/^/   /'
	printf "To:\n   %s\n\n\tcopy?[y/N]" "$destpath"
	read -r ans
	[ "$ans" != "y" ] && exit
	for x in $fx; do
		cp -ivr "$x" "$destpath"
	done &&
	notify-send "📋 File(s) copied." "File(s) copied to $destpath."
}}

cmd setbg "$1"

cmd bulkrename ${{
    tmpfile_old="$(mktemp)"
    tmpfile_new="$(mktemp)"

    [ -n "$fs" ] && fs=$(basename -a $fs) || fs=$(ls)

    echo "$fs" > "$tmpfile_old"
    echo "$fs" > "$tmpfile_new"
    $EDITOR "$tmpfile_new"

    [ "$(wc -l < "$tmpfile_old")" -eq "$(wc -l < "$tmpfile_new")" ] || { rm -f "$tmpfile_old" "$tmpfile_new"; exit 1; }

    paste "$tmpfile_old" "$tmpfile_new" | while IFS="$(printf '\t')" read -r src dst
    do
        [ "$src" = "$dst" ] || [ -e "$dst" ] || mv -- "$src" "$dst"
    done

    rm -f "$tmpfile_old" "$tmpfile_new"
    lf -remote "send $id unselect"
}}


#Redrawn colunas
cmd recol ${{
    w=$(tput cols)
    if [ $w -le 80 ]; then
        lf -remote "send $id set ratios 1:1"
    elif [ $w -le 160 ]; then
        lf -remote "send $id set ratios 1:2:2"
    else
        lf -remote "send $id set ratios 1:3:4:2"
    fi
}}

cmd copypath &{{
    readlink -fn $f | xclip -sel p -f | xclip -sel c &&
    notify-send -t 2000  "Path copiado" "${f}\n\n👣👣👣👣"
}}

# Define a custom command to "copy" files as symlinks
cmd link-copy ${{
    # Clear any previous selection buffer to ensure fresh linking
    rm -f ~/.config/lf/files
    # Write absolute paths of selected files to the lf state buffer
    echo "$fx" > ~/.config/lf/files
    lf -remote "send $id echo Files marked for symlinking 🔗‍️🔗‍️🔗‍️"
}}

# Define a custom command to "paste" the symlinks into the current directory
cmd link-paste ${{
    # Read the marked files from the buffer
    if [ -f ~/.config/lf/files ]; then
        cat ~/.config/lf/files | tr ':' '\n' | while read -r file; do
            # Ensure the source file exists before creating the link
            if [ -e "$file" ]; then
                # Create the symlink in the current working directory ($PWD)
                ln -sf "$file" .
            fi
        done
        lf -remote "send $id echo Symlinks created"
    else
        lf -remote "send $id echo 'No files marked for symlinking!'"
    fi
}}

cmd copy-content ${{
    cat $f | xclip -selection clipboard &&
    notify-send -t 2000 "Conteúdo copiado" "$(basename $f)\n\n🐈🐈🐈🐈🐈🐈🐈"
}}

cmd new-file ${{
    printf "Enter filename: "
    read ans

    # Exit if input is empty
    [ -z "$ans" ] && exit 0

    # Check if the file does NOT exist yet, then create it
    if [ ! -f "$ans" ]; then
        touch "$ans"
    fi

    # Open Neovim regardless
    nvim "$ans"
}}

cmd play-mpv ${{
    bash -c 'mpv --loop-file=no --playlist=<(printf "%s\n" "$@")' -- $fx
}}

map zp play-mpv

# Renames
map A :rename; cmd-end # at the very end
map c push A<c-u> # new rename
map I :rename; cmd-home # at the very beginning
map i :rename # before extension
map a :rename; cmd-right # after extension

# Bindings
map <enter> shell
map b $setbg $f
map B bulkrename
map C copyto
map J $lf -remote "send $id cd $(fd . ~ -t d | fzf)" #ir pra qlqr lugar
map D trash
map <c-e> extract
map E $$TERMA -e $EDITOR "$f" &
map <c-f> $lf -remote "send $id select '$(fzf)'" #ir para diretorio local
map <c-g> $lazygit
map <c-y> link-copy
map <c-l> link-paste

map <c-c> copy-content
map r $~/.config/lf/pv.sh $f | less -R
map R $$TERMA -e sh -c '~/.config/lf/pv.sh "$f" | less -R' &
map <c-k> set ratios 1:1
map M moveto
map <c-n> push %mkdir<space>
map <c-j> new-file
map o &mimeopen $f
map O $mimeopen --ask $f

map <c-t> rsyncext
map V $vimdiff $fx
map <c-r> reload
# map <c-t> !mobt $fx
map S shrink
map <c-s> set hidden!
map T $sxiv -t "$(pwd)" # opens thumbnail mode
map x $$f
map X &$f
map Y copypath
map <delete> delete
map <c-z> zip

# Source Bookmarks
source "~/.config/lf/shortcutrc"
