ncmpcpp_directory = ~/.config/ncmpcpp

mpd_music_dir = "~/music"

# mpd_host = "127.0.0.1"
# mpd_port = "6600"
mouse_list_scroll_whole_page = "yes"
lines_scrolled = "1"

# current_item_prefix = $(magenta)$r$b
# current_item_suffix = $/r$(end)$/b
current_item_inactive_column_prefix = $(cyan)$r
current_item_inactive_column_suffix = $/r$(end)

visualizer_in_stereo = "yes"
# visualizer_data_source = "/tmp/mpd.fifo"
visualizer_output_name = "my_fifo"
visualizer_type = "spectrum"
visualizer_look = "▋▋"

# message_delay_time = "3"
playlist_shorten_total_times = "yes"
playlist_display_mode = "columns"
# playlist_separate_albums = "yes"
browser_display_mode = "columns"
browser_sort_mode = "mtime"
search_engine_display_mode = "columns"
playlist_editor_display_mode = "columns"
autocenter_mode = "yes"
centered_cursor = "yes"
user_interface = "alternative"
follow_now_playing_lyrics = "yes"
lyrics_directory = /home/zerinol/.config/ncmpcpp/lyrics
locked_screen_width_part = "60"
display_bitrate = "no"
external_editor = "vim"

media_library_sort_by_mtime = yes
media_library_primary_tag = album_artist
# main_window_highlight_color = "white"
media_library_albums_split_by_date = no

# progressbar_look = "▃▃▃"
progressbar_look = "─⊙ "

mouse_support = "yes"
header_visibility = "no"
statusbar_visibility = "yes"

visualizer_color = "white"
titles_visibility = "no"
enable_window_title = "yes"

header_window_color = 4
volume_color = 2
statusbar_color = 5
statusbar_time_color = 3
player_state_color = 3
state_line_color = 8
state_flags_color = 4
main_window_color = 8
color1 = 5
color2 = 6

progressbar_color = 8
progressbar_elapsed_color = 2

# song_columns_list_format = "(20)[]{a} (6f)[green]{NE} (50)[white]{t|f:Title} (20)[cyan]{b|D} (7f)[magenta]{l}"
song_window_title_format = " {%a} - {%t|%f}"
# song_status_format = "$b$7♫ $2%a $4⟫$3⟫ $8%t $4⟫$3⟫ $5%b "
song_status_format = "$b$7♫ $9%D$4/%f "
song_list_format = {%a - }{%t}|{$7%f$9}$R{$3%l$9}
