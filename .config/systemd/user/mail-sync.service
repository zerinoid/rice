[Unit]
Description=Background Mail Sync & Notification Service

[Service]
Type=oneshot
Environment="PATH=/home/zerinol/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="DISPLAY=:1"
ExecStart=/bin/bash /home/zerinol/.local/bin/mail-sync

[Install]
WantedBy=default.target
